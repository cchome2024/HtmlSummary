## LLM provider configuration (defaults target DeepSeek)
# Choose provider: deepseek | openai
LLM_PROVIDER=deepseek

# API key (required to use LLM). For DeepSeek, use your DeepSeek API key.
LLM_API_KEY=sk-8de91aeae7844650b80c398ebb81aa60

# Base URL (DeepSeek is OpenAI-compatible)
# DeepSeek default base URL:
LLM_BASE_URL=https://api.deepseek.com

# Model name
# For DeepSeek typical options: deepseek-chat, deepseek-reasoner
LLM_MODEL=deepseek-chat

# You can still use legacy vars if desired
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Optional: Flask summary archive service
SUMMARY_SERVICE_BASE_URL=http://43.153.52.15:8050
# Optional: MCP summary archive service
SUMMARY_MCP_BASE_URL=http://127.0.0.1:8150
