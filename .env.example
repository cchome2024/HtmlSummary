## LLM provider configuration (defaults target DeepSeek)
# Choose provider: deepseek | openai
LLM_PROVIDER=deepseek

# API key (required to use LLM). For DeepSeek, use your DeepSeek API key.
LLM_API_KEY=your_deepseek_api_key_here

# Base URL (DeepSeek is OpenAI-compatible)
# DeepSeek default base URL:
LLM_BASE_URL=https://api.deepseek.com

# Model name
# For DeepSeek typical options: deepseek-chat, deepseek-reasoner
LLM_MODEL=deepseek-chat

# You can still use legacy vars if desired
# OPENAI_API_KEY=
# OPENAI_MODEL=
